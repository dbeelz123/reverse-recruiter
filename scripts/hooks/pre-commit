#!/bin/sh
# Pre-commit privacy check: no personal details in anything being committed.
#
# One-time setup in each clone (nothing personal is stored in the repo):
#   git config core.hooksPath scripts/hooks
#   git config reverse-recruiter.privateTerms "<path to your private-terms.txt, outside this repo>"
#
# Blocks the commit when:
#   - a staged path is a personal-data folder (by name, or by the data-folder layout under any name, except
#     the fictional sample-data/) or a private-terms list;
#   - a staged file is a document format the scan can't read (PDF, Word, Excel, PowerPoint, RTF, email);
#   - engine/privacy_scan.py finds a private term, a home-folder path, an email address or a LinkedIn profile
#     link in any staged text file, or a staged image that isn't listed in .privacy-allow as checked by eye;
#   - a staged file can't be copied for the scan;
#   - no private-terms list is configured (the scan runs with --strict).
# Deliberate exceptions live in .privacy-allow ("<path> | <phrase>"): review any change to that file carefully.
#
# The other hooks in this folder close the gaps this one leaves: pre-merge-commit (a merge runs that hook instead of
# this one), commit-msg (the message is published too) and pre-push (a cherry-pick, rebase or revert runs no commit
# hook at all, and --no-verify skips them, so every commit is checked again before it leaves the machine).

hook=pre-commit
. "$(dirname "$0")/lib.sh"
need_terms

# T (type change) is included: a file replaced by a symbolic link is a change to what gets published.
# core.quotePath=false: by default git prints a name with accented or other non-ASCII letters in quotes with
# escapes, which is not the file's name, so such a file could never be copied for the scan (or committed).
files=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMRT)
[ -z "$files" ] && exit 0

bad=$(printf '%s\n' "$files" | personal_paths | grep -v '^$')
if [ -n "$bad" ]; then
    echo "pre-commit: personal-data paths are staged:"
    printf '  %s\n' $bad
    exit 1
fi

docs=$(printf '%s\n' "$files" | document_paths)
if [ -n "$docs" ]; then
    echo "pre-commit: document files are staged; the privacy scan can't read inside them:"
    printf '  %s\n' $docs
    echo "Keep resumes, saved postings and exports in your data folder, outside the repo."
    exit 1
fi

# Scan the staged versions (what will actually be committed), copied to a temporary folder.
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
# Every copy must succeed: a missing or partial copy would be scanned as if complete. (The loop reads a here-document,
# not a pipe, so exit stops the hook itself rather than a subshell.)
while IFS= read -r f; do
    # dirname gets the whole path, never the bare name: a folder called "-notes" would read as an option.
    if ! mkdir -p "$(dirname "$tmp/$f")" || ! git show ":$f" > "$tmp/$f"; then
        echo "pre-commit: could not copy the staged version of $f for the privacy scan; commit blocked."
        exit 1
    fi
done <<EOF
$files
EOF
# Deliberate exceptions (e.g. the author's name in LICENSE) come from the staged .privacy-allow only.
[ -f "$tmp/.privacy-allow" ] || git show ":.privacy-allow" > "$tmp/.privacy-allow" 2>/dev/null || rm -f "$tmp/.privacy-allow"

PYTHONDONTWRITEBYTECODE=1 "$py" engine/privacy_scan.py "$tmp" --terms "$terms" --strict --no-skip
status=$?
if [ $status -ne 0 ]; then
    echo "pre-commit: privacy scan failed (paths above are inside a temporary copy of the staged files)."
    exit 1
fi
exit 0
